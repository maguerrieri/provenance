# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# local research data — cached pages and outputs stay off git
data/cache/
# a stray per-candidate cache (see _cache_root) — may hold a copied 1.5 GB CAL-ACCESS database
data/*/cache/
data/out/
data/claims/
# the retired `vg remap`'s marker described data/claims/, so an old one stays out of git with it
data/.remap-applied

# agent worktrees live inside the repo; they are never part of it
.claude/worktrees/

# the CAL-ACCESS export and its SQLite index are large and regenerable
data/cache/calaccess/

# what an interrupted re-home by the retired `vg remap` may have left (CLAUDE.md, "Question ids
# are stable and never reused")
judgments-backup/
judgments-backup.partial/
judgments-backup.discard/
